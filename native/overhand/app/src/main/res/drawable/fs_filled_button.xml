<?xml version="1.0" encoding="utf-8"?>
<!-- look_nov17 s2 Controls: filled button, cyan fill, dark text; dim (cyan 50%, no edge) until enabled (Question.dc.html Confirm). Pointed at / pressed: spec silent, K2 chose a text-colour edge / 50% fill. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_enabled="false"><shape android:shape="rectangle"><corners android:radius="999dp"/><solid android:color="@color/fs_cyan_50"/></shape></item>
  <item android:state_pressed="true"><shape android:shape="rectangle"><corners android:radius="999dp"/><solid android:color="@color/fs_cyan_50"/><stroke android:width="2dp" android:color="@color/fs_cyan"/></shape></item>
  <item android:state_hovered="true"><shape android:shape="rectangle"><corners android:radius="999dp"/><solid android:color="@color/fs_cyan"/><stroke android:width="2dp" android:color="@color/fs_text"/></shape></item>
  <item><shape android:shape="rectangle"><corners android:radius="999dp"/><solid android:color="@color/fs_cyan"/><stroke android:width="2dp" android:color="@color/fs_cyan"/></shape></item>
</selector>
