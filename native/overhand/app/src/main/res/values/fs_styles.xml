<?xml version="1.0" encoding="utf-8"?>
<!-- look_nov17 s2 Controls/Type. Optional declarative counterparts of PanelPolish's runtime kit. -->
<resources>
  <style name="fs_text_button" parent="@android:style/Widget.Button">
    <item name="android:background">@drawable/fs_text_button</item>
    <item name="android:backgroundTint">@null</item>
    <item name="android:stateListAnimator">@null</item>
    <item name="android:minHeight">72dp</item><item name="android:minWidth">72dp</item>
    <item name="android:textSize">30sp</item><item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:textAllCaps">false</item><item name="android:textColor">@color/fs_text_on_button</item>
    <item name="android:paddingLeft">20dp</item><item name="android:paddingRight">20dp</item>
    <item name="android:paddingTop">8dp</item><item name="android:paddingBottom">8dp</item>
  </style>
  <style name="fs_filled_button" parent="fs_text_button">
    <item name="android:background">@drawable/fs_filled_button</item>
    <item name="android:textColor">@color/fs_text_on_filled</item>
  </style>
  <style name="fs_icon_button" parent="@android:style/Widget.ImageButton">
    <item name="android:layout_width">72dp</item><item name="android:layout_height">72dp</item>
    <item name="android:background">@drawable/fs_icon_button</item>
    <item name="android:backgroundTint">@null</item><item name="android:tint">@color/fs_icon_tint</item>
    <item name="android:minHeight">72dp</item><item name="android:minWidth">72dp</item>
  </style>
  <style name="fs_switch" parent="@android:style/Widget.Material.CompoundButton.Switch">
    <item name="android:background">@null</item>
    <item name="android:thumb">@drawable/fs_switch_thumb</item><item name="android:track">@drawable/fs_switch_track</item>
    <item name="android:minHeight">64dp</item><item name="android:minWidth">64dp</item>
    <item name="android:textSize">30sp</item><item name="android:fontFamily">sans-serif-medium</item>
    <item name="android:textColor">@color/fs_text</item><item name="android:switchPadding">16dp</item>
  </style>
  <style name="fs_tab" parent="fs_text_button"><item name="android:background">@drawable/fs_tab</item></style>
</resources>
