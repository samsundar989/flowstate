{
  "name": "agent-deck-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent event stream bridge: replay JSONL fixtures or convert live Claude Code runs, served over WebSocket.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "replay": "node --experimental-strip-types --no-warnings src/replay.ts",
    "live": "node --experimental-strip-types --no-warnings src/live.ts",
    "record": "node --experimental-strip-types --no-warnings src/record.ts",
    "client": "node --experimental-strip-types --no-warnings src/client.ts",
    "gen-fixtures": "node --experimental-strip-types --no-warnings src/gen_fixtures.ts",
    "stats": "node --experimental-strip-types --no-warnings src/stats.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3"
  }
}
