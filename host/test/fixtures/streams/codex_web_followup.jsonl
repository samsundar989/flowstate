{"type":"item.completed","item":{"id":"item_1","type":"file_change","status":"completed","changes":[{"path":"{{CWD}}\\index.html","kind":"add","_content":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=1280,height=800\">\n<title>Tap counter</title><link rel=\"stylesheet\" href=\"style.css\"></head>\n<body class=\"theme-dark\"><main>\n<h1>Tap counter</h1>\n<div id=\"count\" aria-live=\"polite\">0</div>\n<button id=\"tap\" type=\"button\">Tap</button>\n<button id=\"minus\" type=\"button\">Minus one</button>\n<button id=\"reset\" type=\"button\">Reset</button>\n</main><script src=\"app.js\"></script></body></html>\n"},{"path":"{{CWD}}\\app.js","kind":"add","_content":"let n = 0;\nconst out = document.getElementById(\"count\");\nconst show = () => { out.textContent = String(n); };\ndocument.getElementById(\"tap\").addEventListener(\"click\", () => { n += 1; show(); });\ndocument.getElementById(\"minus\").addEventListener(\"click\", () => { n = Math.max(0, n - 1); show(); });\ndocument.getElementById(\"reset\").addEventListener(\"click\", () => { n = 0; show(); });\nshow();\n"}]}}
